---
import { getImage } from 'astro:assets';
import '../styles/tokens.css';
import '../styles/fonts.css';
import '../styles/base.css';
import socialCard from '../assets/social-card.jpg';

interface Props {
  title: string;
  description: string;
  /** Opt a single page OUT of indexing. Defaults to false: the site is
      launched, so a new page is indexable unless it says otherwise. `/404`
      is the only page that sets it — see docs/content-architecture.md. */
  noindex?: boolean;
  /** JSON-LD, e.g. a Person or CreativeWork graph. Omit if the page has none. */
  structuredData?: Record<string, unknown>;
  /** The page's Social Card source — for a Project, `images[0]`. A page says
      WHICH image; it never says how to crop it. See docs/content-architecture.md
      §6. Omit to get the site-wide card. */
  image?: { src: ImageMetadata; alt: string };
}

const { title, description, noindex = false, structuredData, image } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

/**
 * The site-wide default. It applies to EVERY page that does not name its own
 * image, `/404` included — a carve-out would only mean one route unfurls as a
 * bare link, and nobody shares a 404 on purpose anyway.
 *
 * This alt string is the one on the site not enforced by a schema: every other
 * alt comes through `alt: z.string().min(1)` on the Project collection. It is a
 * constant here because the card is a constant.
 */
const card = image ?? { src: socialCard, alt: 'Coulter Heiberger — Technical Artist' };

/**
 * THE LAYOUT OWNS THE CROP. `getImage` with both dimensions resizes `fit: 'cover'`
 * from centre, so any source becomes 1200x630 without the page knowing the ratio
 * exists. Keeping it here is what stops a second, divergent card mechanism
 * appearing the first time a page wants a different aspect.
 *
 * 1200x630 is provisional framing, not a settled one. Astro crops from centre and
 * a centre crop recomposes nothing — the same defect
 * [#30](https://github.com/imecoulter/coulterheiberger-com/issues/30) tracks for
 * the 21:9 and 4:5 art-directed crops. This is that issue's THIRD ratio, and
 * whatever framing mechanism it lands must cover the card too.
 *
 * `format: 'jpeg'` rather than the delivery pipeline's AVIF/WebP: crawler support
 * for modern formats is uneven and a card that some scrapers cannot decode is
 * worse than a slightly larger one nobody's LCP Path pays for.
 */
const ogImage = await getImage({ src: card.src, width: 1200, height: 630, format: 'jpeg' });
const ogImageURL = new URL(ogImage.src, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Coulter Heiberger" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={card.alt} />
    {/* Unconditional, because the card is. `summary` was correct while #14 shipped
        the metadata with no image at all; every page now has one. */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    {structuredData && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
    )}
    {/* Registration is opt-in via [data-anim] and gated on this script, so with
        scripting off the marked elements would stay hidden. The selector is
        :root-qualified to outrank base.css's equal-specificity [data-anim]
        rules regardless of where Astro injects the stylesheet. */}
    <noscript>
      <style>
        :root [data-anim] {
          opacity: 1;
          transform: none;
          clip-path: none;
        }
      </style>
    </noscript>
  </head>
  <body>
    <slot />
    <script>
      // Registration — the only JavaScript on the site. It adds .is-in once per
      // element and stops watching; the moves themselves are CSS in base.css.
      //
      // Inline on purpose. Issue #12 measured this at 195 B gzip with ZERO
      // extra requests: Astro inlines a script that imports nothing. Every
      // library candidate emitted an _astro/*.js file instead, which under the
      // perf gate's devtools throttling costs 562.5ms of latency before
      // anything it reveals can paint — and lands on the LCP Path besides.
      //
      // No reduced-motion check here. base.css declares the hidden state only
      // under (prefers-reduced-motion: no-preference), so under `reduce` this
      // adds a class that changes nothing. Registration is the enhancement;
      // the plain document is the baseline.
      const io = new IntersectionObserver(
        (entries) => {
          let i = 0;
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            const el = entry.target as HTMLElement;
            // Staggered in groups of four at 60ms (docs/design-direction.md).
            el.style.setProperty('--d', `${(i % 4) * 60}ms`);
            el.classList.add('is-in');
            io.unobserve(el);
            i++;
          }
        },
        { rootMargin: '0px 0px -12% 0px' },
      );

      for (const el of document.querySelectorAll('[data-anim]')) io.observe(el);
    </script>
  </body>
</html>
