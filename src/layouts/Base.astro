---
import { getImage } from 'astro:assets';
import '../styles/tokens.css';
import '../styles/fonts.css';
import '../styles/base.css';
import socialCard from '../assets/social-card.jpg';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  /** Opt a single page OUT of indexing. Defaults to false: the site is
      launched, so a new page is indexable unless it says otherwise. `/404`
      is the only page that sets it — see docs/content-architecture.md. */
  noindex?: boolean;
  /** JSON-LD, e.g. a Person or CreativeWork graph. Omit if the page has none. */
  structuredData?: Record<string, unknown>;
  /** The page's Social Card source — for a Project, `images[0]`. A page says
      WHICH image and states its composition; it never says how to crop it. See
      docs/content-architecture.md §6. Omit to get the site-wide card.

      `framing` joined this prop when the Project routes landed. It is the same
      per-image keyword the two art-directed crops use, not a second mechanism:
      the page still hands over a composition decision and the layout still owns
      the ratio. It closes §6's "provisional framing" note, which was issue
      #30's third ratio waiting for the first page that had one to pass. */
  image?: { src: ImageMetadata; alt: string; framing?: string };
}

const { title, description, noindex = false, structuredData, image } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

/**
 * The site-wide default. It applies to EVERY page that does not name its own
 * image, `/404` included — a carve-out would only mean one route unfurls as a
 * bare link, and nobody shares a 404 on purpose anyway.
 *
 * This alt string is the one on the site not enforced by a schema: every other
 * alt comes through `alt: z.string().min(1)` on the Project collection. It is a
 * constant here because the card is a constant.
 */
const card = image ?? {
  src: socialCard,
  alt: 'Coulter Heiberger | Technical Artist',
  /* The typographic default is composed for its own frame at 2400x1260, which
     is already 1200x630's ratio, so this crop takes nothing off any edge. */
  framing: 'centre',
};

/**
 * THE LAYOUT OWNS THE CROP. `getImage` with both dimensions resizes `fit: 'cover'`
 * from centre, so any source becomes 1200x630 without the page knowing the ratio
 * exists. Keeping it here is what stops a second, divergent card mechanism
 * appearing the first time a page wants a different aspect.
 *
 * 1200x630 was issue #30's THIRD ratio and it is no longer provisional. `position`
 * carries the page's own `framing` keyword into the same crop this layout was
 * already performing, so a Project's card recomposes on the axis its author chose
 * instead of cutting from centre. One mechanism, not two: the page still only says
 * WHICH image, and the ratio still lives here.
 *
 * `format: 'jpeg'` rather than the delivery pipeline's AVIF/WebP: crawler support
 * for modern formats is uneven and a card that some scrapers cannot decode is
 * worse than a slightly larger one nobody's LCP Path pays for.
 *
 * `layout: 'none'` is load-bearing and easy to delete by accident. astro.config.mjs
 * sets a global default of 'constrained' so no page ships a single-width image by
 * oversight — and that default applies to getImage too, which turned this ONE card
 * into a six-width srcset the moment it was added. Only `.src` is ever read here;
 * the other five encodes were pure build cost and five orphan files in dist.
 */
const ogImage = await getImage({
  src: card.src,
  width: 1200,
  height: 630,
  format: 'jpeg',
  position: card.framing,
  layout: 'none',
});
const ogImageURL = new URL(ogImage.src, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Four links, one mark. All of them are generated from a single SVG by
        scripts/dev/build-favicons.mjs, which is dev-only and committed like the
        social card — CI never runs it.

        The .ico is first and unconditional: browsers request /favicon.ico
        whether it is declared or not, so the choice is between serving the mark
        there and serving a 404 there. The SVG follows and wins in every engine
        that supports it, which is where the dark-tab-strip inversion lives.

        The 192px PNG is not redundant with either. Google Search wants a square
        favicon that is a MULTIPLE OF 48 and reachable from a rel="icon", and it
        does not read SVG for this. 192 is 48 x 4.

        No `sizes` on the SVG: it is resolution-independent, and declaring a size
        on it invites an engine to treat it as one raster among several. */}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Coulter Heiberger" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={card.alt} />
    {/* Unconditional, because the card is. `summary` was correct while #14 shipped
        the metadata with no image at all; every page now has one. */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    {structuredData && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
    )}
    {/* NO <noscript> BLOCK, AND NOTHING NEEDS ONE. There used to be one here
        un-hiding Registration's [data-anim] elements, because an entrance that
        starts at opacity 0 and is revealed by script is invisible without it.
        Nothing on the site now starts hidden, so with scripting off every page
        is simply the page. Anything added here that hides an element until
        JavaScript runs needs this block back — see docs/motion.md. */}
  </head>
  <body>
    <slot />
    <Footer />
    <script>
      // THE ONE AUTHORED SCRIPT. Two behaviours live in it — warming the hero
      // and the Expanded View — and that is deliberate: the rule in
      // docs/styling.md is one authored <script>, not one behaviour. A second
      // file, or an island, is an amendment to docs/design-direction.md first.
      // The Cloudflare beacon below is not authored here and is not a precedent
      // for one.
      //
      // IT WAS THREE. Registration's IntersectionObserver and the Traverse's
      // pointer listener were both here and are gone with the rest of the motion
      // substrate; docs/motion.md keeps them. NEITHER OF THE TWO LEFT DRAWS
      // ANYTHING — one fetches an image early, the other opens a <dialog> — so
      // there is no animation in this file and nothing here should acquire one
      // without reading that doc first.
      //
      // Inline on purpose. Issue #12 measured the substrate at 195 B gzip with
      // ZERO extra requests: Astro inlines a script that imports nothing. Every
      // library candidate emitted an _astro/*.js file instead, which under the
      // perf gate's devtools throttling costs 562.5ms of latency before anything
      // it affects can paint — and lands on the LCP Path besides. Adding to this
      // block keeps that property; adding a file loses it.
      //
      // Both behaviours below degrade to the plain document with scripting off:
      // warming is an optimisation nobody sees fail, and every Frame is a real
      // link to its own full-size image.

      // ---- warming the hero -------------------------------------------------
      // Fetches the hero at the width the PROJECT page will lay it out, as soon
      // as a pointer says a Plate is being considered.
      //
      // WHY THERE IS ANYTHING TO WARM. `/` and `/projects/<slug>/` show the
      // same image at different widths, so they resolve different rungs of one
      // ladder — ~1136px against ~1504px at a 1600px window, measured on the
      // built site. So the Project page opens on a hero that is a real network
      // fetch, and this buys it the width of a deliberate movement toward the
      // link. It used to have a second job, hiding that fetch under the Carry's
      // cross-fade; the Carry is gone and the head start is not.
      //
      // NOT A HOVER EFFECT, despite the trigger. Nothing about the page changes
      // when this runs — it is a cache warm with no visual, which is why it
      // survived a pass that removed every hover behaviour on the site.
      //
      // NO URL ARITHMETIC. The srcset is read off the <source> already in the
      // page and handed to a detached Image with the Project page's `sizes`
      // (data-hero-sizes, from layout.ts) — so the browser performs the same
      // selection it will perform on arrival, and a ladder change needs no edit
      // here. Setting `sizes` BEFORE `srcset` is load-bearing: the selection
      // happens when srcset is assigned.
      //
      // ENTER AND DOWN, both, and neither is redundant. Enter buys the width of
      // a deliberate movement toward the link; down is the floor for anyone who
      // arrives already moving. Once per Plate — the browser cache is the state,
      // so a second Image would be a second cache hit and nothing else.
      //
      // GATED ON A FINE POINTER, which is not a proxy for a screen size here.
      // In the mobile mode both documents lay the hero out at the same width and
      // take the SAME file, so there is nothing to warm and a phone would be
      // spending real bytes on a file it already has.
      const plates = document.querySelector<HTMLElement>('.plates');
      if (plates?.dataset.heroSizes && matchMedia('(hover: hover) and (pointer: fine)').matches) {
        const heroSizes = plates.dataset.heroSizes;

        for (const plate of plates.querySelectorAll<HTMLElement>('.plate')) {
          let warmed = false;
          const warm = () => {
            if (warmed) return;
            warmed = true;
            // The wide AVIF tier, which is what any browser reaching this line
            // will take. A browser without AVIF gets no warming and the plain,
            // slightly slower arrival — it is already the population being
            // served the single-width fallback.
            const source = plate.querySelector<HTMLSourceElement>('source[type="image/avif"]');
            if (!source) return;
            const warmer = new Image();
            warmer.sizes = heroSizes;
            warmer.srcset = source.srcset;
          };

          plate.addEventListener('pointerenter', warm);
          plate.addEventListener('pointerdown', warm);
        }
      }

      // ---- the Expanded View ------------------------------------------------
      // Frames on a Project page are links to their own full-size file. This
      // intercepts the click and shows it in a <dialog> instead; with scripting
      // off, or on a modified click, the link does what a link does.
      //
      // <dialog>.showModal() is carrying the accessibility here: focus moves
      // into the dialog, the rest of the document goes inert, Escape closes,
      // and focus returns to the Frame that was opened. Hand-rolling any of
      // that is how a keyboard trap gets shipped — and ADR-0003 notes that a
      // keyboard trap is precisely what the Lighthouse score cannot see.
      const expanded = document.querySelector<HTMLDialogElement>('dialog.expanded');
      if (expanded) {
        const view = expanded.querySelector('img')!;

        for (const link of document.querySelectorAll<HTMLAnchorElement>('a.expand')) {
          link.addEventListener('click', (event) => {
            // Let the browser have cmd/ctrl/shift-click and anything with a
            // modifier. Opening a new tab is a reasonable thing to want from a
            // link to an image, and taking it away is the cost of hijacking one.
            if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
            event.preventDefault();
            // The alt travels with the image. It is the same picture, so it is
            // the same description, and the dialog would otherwise present an
            // unlabelled one.
            view.alt = link.querySelector('img')?.alt ?? '';
            view.src = link.href;
            expanded.showModal();
          });
        }

        // A click that lands on the dialog itself rather than on its contents is
        // a click on the blurred ground around the image. Nothing else in the
        // top layer can be that target.
        expanded.addEventListener('click', (event) => {
          if (event.target === expanded) expanded.close();
        });

        expanded
          .querySelector('[data-close]')!
          .addEventListener('click', () => expanded.close());
      }
    </script>
    {/* Cloudflare Web Analytics — the site's only third-party script, and the
        only one that is not authored here. See ADR-0004.

        It used to be injected at the edge by an auto-install ruleset, which
        meant 11,364 B ran on every page while the repo and CI saw nothing. That
        ruleset is now disabled and the snippet lives here, because if it's on
        the wire, it's in the repo. ADR-0004 records what disabling it actually
        took — `auto_install: false` alone did not stop the injection.

        `is:inline` is required: Astro would otherwise try to process this, and
        the point is to ship Cloudflare's snippet byte-for-byte.

        No PROD branch, on purpose. Cloudflare validates telemetry by postfix
        hostname match, so localhost and *.workers.dev previews are rejected
        server-side — CI measures the 11,340 B against the 50 KB budget while
        reporting nothing. Shipping it conditionally would put the gate back to
        grading a document no visitor receives.

        The token is public by construction; it ships in this HTML. */}
    <script
      is:inline
      type="module"
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "1384ca912aa746e5acc7e4c495a9c460"}'
    ></script>
  </body>
</html>
