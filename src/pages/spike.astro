---
import Base from '../layouts/Base.astro';
import Wrap from '../components/Wrap.astro';
import TopBar from '../components/TopBar.astro';
import Plate from '../components/Plate.astro';
import NightBand from '../components/NightBand.astro';
import SiteFooter from '../components/SiteFooter.astro';

const rowsStill = [
  { term: 'Year', value: '2025' },
  { term: 'Credit', value: 'Made at MIR for Bjarke Ingels Group' },
  { term: 'Engine', value: 'Cycles' },
  { term: 'Output', value: '3200 px · 41 min / frame' },
];

const rowsTool = [
  { term: 'Year', value: '2025' },
  { term: 'Credit', value: 'Made at MIR for Bjarke Ingels Group' },
  { term: 'Engine', value: 'WebGL2' },
  { term: 'Output', value: '1920 px · 60 fps · 14 M points' },
];
---

<Base title="North Basin — Coulter Heiberger" description="Spike page for issue #11.">
  <TopBar current="index" />

  <main>
    <Wrap>
      <section class="masthead">
        <span class="label">Project 01 / Competition</span>
        <h1>North Basin</h1>
        <p class="lede">
          A tidal swimming basin cut into a disused container quay — proposed as a year-round public
          room rather than a summer amenity.
        </p>
        <hr />
      </section>

      <Plate
        index="01"
        what="Dusk, north elevation"
        spec="Cycles · 3200 px · 41 min"
        alt="Dusk view across the basin toward the north elevation."
        wide="/plate-wide.svg"
        tall="/plate-tall.svg"
        width={2100}
        height={900}
        priority
        rows={rowsStill}
      />
    </Wrap>

    <NightBand>
      <Wrap>
        <span class="label">Also part of this project</span>
        <h2>Basin survey viewer</h2>
        <Plate
          index="02"
          what="Survey viewer, quay edge"
          spec="WebGL2 · 1920 px · 60 fps"
          alt="Point-cloud survey of the quay in a wireframe viewport."
          wide="/plate-tool.svg"
          tall="/plate-tool-tall.svg"
          width={2400}
          height={1000}
          rows={rowsTool}
        />
      </Wrap>
    </NightBand>
  </main>

  <SiteFooter />
</Base>

<style>
  .masthead {
    padding-block: calc(var(--rhythm) * 0.45) 0;
  }

  .label {
    display: block;
    margin-bottom: 20px;
    font-family: var(--f-mono);
    font-size: var(--t-label);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--track-label);
    color: var(--muted);
  }

  h1 {
    font-size: clamp(2.4rem, 7.4vw, 5.25rem);
    line-height: 0.96;
    letter-spacing: -0.022em;
  }

  h2 {
    font-size: clamp(1.6rem, 3.4vw, 2.6rem);
    line-height: 1.06;
    margin-top: 20px;
  }

  .lede {
    font-size: clamp(1.125rem, 1.9vw, 1.375rem);
    line-height: 1.5;
    max-width: 52ch;
    margin: 24px 0 0;
  }

  hr {
    height: 1px;
    background: var(--rule);
    border: 0;
    margin: 32px 0 0;
  }
</style>
