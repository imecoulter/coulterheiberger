---
import Base from '../layouts/Base.astro';

const email = 'ime@coulterheiberger.com';

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Coulter Heiberger',
  jobTitle: 'Architectural Visualization Specialist',
  url: 'https://coulterheiberger.com',
  email: `mailto:${email}`,
};
---

<Base
  title="Coulter Heiberger — Architectural Visualization"
  description="Architectural visualization by Coulter Heiberger. Portfolio in progress."
  structuredData={person}
>
  <main>
    <span class="t-label">Portfolio in progress</span>
    <h1>Coulter Heiberger</h1>
    <p class="role">Architectural Visualization</p>
    <p class="t-spec"><a href={`mailto:${email}`}>{email}</a></p>
  </main>
</Base>

<style>
  main {
    max-width: 1600px;
    margin-inline: auto;
    padding: var(--rhythm) var(--gutter);
  }

  .t-label {
    display: block;
    margin-bottom: 20px;
  }

  h1 {
    font-size: clamp(2.4rem, 7.4vw, 5.25rem);
    line-height: 0.96;
    letter-spacing: -0.022em;
  }

  .role {
    margin: 24px 0 0;
    font-size: clamp(1.125rem, 1.9vw, 1.375rem);
    line-height: 1.5;
  }

  .t-spec {
    margin: calc(var(--rhythm) * 0.5) 0 0;

    & a {
      text-decoration: none;
      border-bottom: 1px solid var(--rule);
    }
  }
</style>
