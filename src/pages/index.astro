---
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Plate from '../components/Plate.astro';
import portrait from '../assets/portrait.jpg';
import {
  detailWideSizes,
  portraitSizes,
  PORTRAIT_WIDTH,
  PORTRAIT_WIDTHS,
  FRAME_FORMATS,
  FRAME_FALLBACK,
} from '../layout';
import { EMAIL, LINKEDIN } from '../site';

/* sameAs is legal here because the footer renders the link — the governing rule
   in docs/content-architecture.md is that if no page renders a field, the field
   does not exist.

   `address` NOW PASSES THAT TEST and is below. It used to be held out with the
   note "until /about/ lands"; /about/ime/ has landed and states the location in
   prose, so the field has the page it needed. It is still not a frontmatter
   field anywhere — one page says it once. */

// `worksFor` and `affiliation` are NEVER added here. They are the obvious next
// schema.org enrichment and they are wrong: this site describes an independent
// practice, and an organization edge would assert something it does not claim.
// See ADR-0005.
//
// There is deliberately no CreativeWork graph for the Projects below. No
// document asks for one, and the rule at the top of content-architecture.md
// cuts both ways: structured data nobody consumes is a second description of
// the page to keep in sync with the first.
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Coulter Heiberger',
  jobTitle: 'Technical Artist',
  url: 'https://coulterheiberger.com',
  email: `mailto:${EMAIL}`,
  /* Locality and region only. There is no street address on the site and there
     is not going to be one — this states where the practice is, which is what
     /about/ime/ says in prose, and nothing more precise than that page does. */
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Minneapolis',
    addressRegion: 'MN',
    addressCountry: 'US',
  },
  sameAs: [LINKEDIN],
};

// `order` is curation, not chronology — see content-architecture.md §2. `year`
// is display only and is never the sort key.
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

const ordinal = (n: number) => String(n).padStart(2, '0');
---

<Base
  title="Coulter Heiberger | Technical Artist"
  description="Real-time systems for spatial environments: terrain, architecture, simulation, and interactive experiences."
  structuredData={person}
>
  <main>
    {/* THE MASTHEAD (CONTEXT.md), and it is deliberately not a Plate. The Plate
        contract is what makes six Projects differ in subject rather than in
        status, and a person entered into it would be exactly the status
        difference the contract removes. So this borrows the Plate's grid and
        its left datum edge, and nothing else: no ordinal, no link overlay, no
        art-directed crop, and it sits outside the <ol>.

        WHAT MAKES IT BELONG ANYWAY is the specification line below. The datum
        is the specification line (docs/design-direction.md), so an element that
        carries one is measured by the same reference as everything under it,
        without being the same kind of object.

        THE COLUMNS ARE SWAPPED against a Plate, and that is the whole visual
        argument: a Plate is an image with metadata beside it, this is prose
        with a face beside it. Same two columns, same gap, same edge, opposite
        weights. */}
    <header class="masthead">
      <div class="masthead-text">
        <span class="t-label eyebrow">Selected work</span>
        <h1>Coulter Heiberger</h1>

        {/* ADR-0005: the display line is `Technical Artist`, unqualified. Not
            "Technical Artist / Architectural Visualization", not a
            parenthetical. Qualifiers go on the specification line below, where
            they read as scope rather than as a job title that could not decide
            what it was. */}
        <p class="t-label role">Technical Artist</p>

        <p class="positioning">
          I build real-time systems for spatial environments: terrain,
          architecture, simulation, and interactive experiences. Most of the work
          starts with real-world data, processed into environments that hold up
          at 1:1 scale under true coordinates.
        </p>

        {/* THE PRACTICE'S OWN SPECIFICATION LINE. Same type role and same
            separator as every Plate's, because it is the same line doing the
            same job one level up: the six below say what a Project was made
            with, this says what the practice is made of.

            IT DOES NOT OPEN WITH `TECHNICAL ARTIST`, and ADR-0005's example
            string does. That example is written for a site where the role is
            NOT already on the page; here the display line sits two lines above
            in this exact mono, so leading with it printed the same words twice
            in the same style within 60 px. The ADR's rule is that qualifiers
            live on the spec line rather than on the display line, and that rule
            is better served by the line carrying only what the display line
            does not say. Seen on the rendered page, which is where ADR-0005
            says this kind of call gets made. */}
        <p class="t-spec spec">Real-time 3D · Geospatial pipelines · Interactive systems</p>
      </div>

      <div class="masthead-aside">
        {/* <Picture>, not the Plate's hand-assembled <picture>. That component
            exists to switch COMPOSITION across the mode boundary, and a square
            portrait has one composition — so the component that only switches
            format is the correct one, which is the same call
            `/projects/<slug>/` makes for a Frame.

            AVIF WITH A WEBP FALLBACK, from the same two constants the gallery
            uses. Not a new decision: this element sits in the first viewport on
            `/`, so it is fetched immediately whatever `loading` says, and the
            gallery's own measurement was a 53% cut moving WebP q80 to AVIF q50.
            Keeping the formats in layout.ts is also what stops CI's
            processed-image cache going stale on them — the note there explains
            what that cost once.

            NOT `priority`. The first Plate keeps it: this is a 320 px square
            against a 21:9 band, so it is not the LCP element on any viewport
            where the band is in view, and claiming the LCP slot for a face
            would take it off the work. Measured under `npm run budget`, not
            assumed — see the note on `first` below. */}
        <Picture
          src={portrait}
          alt="Coulter Heiberger, smiling, in glasses and a light blue collared shirt against a warm stucco wall."
          width={PORTRAIT_WIDTH}
          height={PORTRAIT_WIDTH}
          widths={PORTRAIT_WIDTHS}
          sizes={portraitSizes}
          formats={FRAME_FORMATS}
          fallbackFormat={FRAME_FALLBACK}
          loading="lazy"
          decoding="async"
        />

        {/* One ordinary link, and no overlay. The `.title a::after` trick below
            exists because a Plate's whole row is one target; this element has
            two things in it a visitor might want and only one of them is a
            link. The border is the affordance, for the reason Footer.astro
            gives: `link-in-text-block` is gated at error, and base.css hands
            every <a> `color: inherit`, so a link distinguished by colour alone
            would be distinguished by nothing at all. */}
        <a class="t-label about" href="/about/ime/">About</a>
      </div>
    </header>

    {/* Not a card grid. design-direction.md cut the persistent metadata rail
        with a specific replacement — "a column beside it on desktop, the same
        rows stacked above it at 390 px" — so the metadata belongs to the Plate
        and travels with it. One Plate per row, six rows. */}
    {/* data-hero-sizes is what the PROJECT PAGE lays its hero out at, parked on
        `/` for the warming in Base.astro to read. The two pages share one
        srcset and differ only in `sizes`, so this one string is the whole
        difference between the file a visitor already has and the one the next
        document will ask for — the script hands it to a detached Image and lets
        the browser pick the rung itself, rather than doing that arithmetic
        twice in two languages.

        ONE COPY, ON THE LIST, not one per Plate: it is the same string for all
        six, and this document is on the LCP Path. It comes from layout.ts for
        the reason every other `sizes` does — a hand-copied number here would
        drift from the CSS silently and warm the wrong file, which looks exactly
        like no warming at all. */}
    <ol class="plates" data-hero-sizes={detailWideSizes}>
      {
        projects.map((project, i) => {
          /* `first` IS ONLY ABOUT `priority`. The LCP element takes eager, sync
             and fetchpriority high, and there is at most one per page.

             SINCE THE MASTHEAD, THE LCP ELEMENT ON THIS PAGE DEPENDS ON THE
             VIEWPORT, and `priority` is a build-time boolean that cannot say so.
             Measured, not assumed:

               mobile 390x844, throttled 4G   p.positioning   750-811 ms
               desktop 1440x900               this <img>       (unthrottled)

             The Masthead is roughly one screen on a phone, so the band drops
             below the fold and the positioning paragraph becomes the largest
             thing painted. `/` moved into the text-LCP regime the precedent
             analysis found every fast site in — LCP Path on this document is now
             6.5 KB.

             PRIORITY STAYS ANYWAY, and the reason is the desktop row above. On a
             landscape window the band is still in view and still the LCP element,
             so dropping this would make the LCP element `loading="lazy"`, which
             is the one thing never to do to it. On mobile it costs nothing
             measurable: at 750 ms the hero has not finished either way, which is
             why the LCP Path number is 6.5 KB and not 100.

             What would change this is the mobile hero becoming the LCP element
             again — i.e. the Masthead getting shorter. Re-read the numbers above
             before assuming either way.

             It used to do a second job. Every Plate arrived on scroll — the
             metadata `rise`, the image `wipe` — and `first` was excluded from
             that, because an element at opacity 0 is not an LCP candidate. The
             entrances went at owner review and the substrate behind them has now
             gone too; docs/motion.md holds both, and the LCP constraint is the
             thing to re-read before any of it comes back. */
          const first = i === 0;
          return (
            /* No data-reveal and no data-anim. This <li> carried the first as the
               Traverse's hover target — the whole Plate, because the link overlay
               below sits on top of the image and a pointer over it targets the
               <a> rather than the <picture>. Nothing on this page responds to a
               pointer now except the link itself. */
            <li class="plate">
              <div class="plate-meta">
                {/* The Plate index: a rule, then the zero-padded ordinal in
                    .t-spec like every other mono line. Both in ink. */}
                <p class="t-spec ordinal">{ordinal(project.data.order)}</p>

                <h2 class="title">
                  <a href={`/projects/${project.id}/`}>{project.data.title}</a>
                </h2>

                <p class="summary">{project.data.summary}</p>

                {/* The Specification Line. `credit` is deliberately NOT here —
                    content-architecture.md §2 puts provenance on the detail
                    page's fact block, and an index that states where every
                    piece was made is an index about employment. */}
                <p class="t-spec spec">{project.data.spec}</p>
                <p class="t-spec year">{project.data.year}</p>
              </div>

              <div class="plate-media">
                <Plate frame={project.data.images[0]} context="index" priority={first} />
              </div>
            </li>
          );
        })
      }
    </ol>
  </main>
</Base>

<style>
  /* All THREE type roles are live on this page now, where before it was two.
     The serif arrives with the summaries: docs/design-direction.md says `/` is
     Montserrat and mono only "because four lines with no prose on them have
     nothing for the serif to do", and six summaries are prose. Three is the
     cap, not a quota, and the serif is a system stack — 0 B on the wire. */
  main {
    max-width: var(--measure-page);
    margin-inline: auto;
    padding: var(--rhythm) var(--gutter);
  }

  /* ---- the Masthead ------------------------------------------------------
     The Plate's grid with the columns swapped. Every value here is the token
     the Plate below uses, not a number that happens to match it — that is what
     keeps the left datum edge shared when one of them is tuned. */
  .masthead {
    display: grid;
    gap: 32px;
    margin-bottom: var(--rhythm);
  }

  /* Same condition as the Plate, the crops, and tokens.css's gutter switch: a
     SHAPE, not a width. See WIDE_MODE in src/layout.ts.

     The portrait column is placed explicitly rather than reordered, for the
     reason spelled out on the Plate below: DOM order is the reading order, and
     `order` would make the visual arrangement contradict it rather than place
     it. Here the text is first in both, so this is only a placement. */
  @media (min-aspect-ratio: 1 / 1) {
    .masthead {
      grid-template-columns: minmax(0, 1fr) var(--plate-meta);
      gap: var(--plate-gap);
      align-items: start;
    }
  }

  .eyebrow {
    display: block;
    margin-bottom: 20px;
  }

  /* The positioning paragraph, and the reason the serif is on this page at all
     above the Plate summaries. No font-size: it is body prose and it is set
     like body prose, which is the correction tokens.css records against the
     15 px summary size this page used to mint for itself.

     --body-col rather than the column's full width. The wide column runs to
     ~1230 px at the page cap, and 17 px Georgia across that is far past any
     reading measure. The Plate summaries do not need this because 320 px caps
     them already. */
  .positioning {
    margin: 24px 0 0;
    max-width: var(--body-col);
    color: var(--muted);
  }

  /* NO COLOUR OVERRIDE. This was --ink for one draft, to give the practice's own
     line more weight than the six below it. That is exactly the move base.css
     refuses by name: a type style that reads one way in one place and another
     way next to it is not a style, and it is how the footer address became the
     site's tenth treatment. The specification line is one style, and the
     Masthead's is a specification line. Margin only. */
  .masthead .spec {
    margin: 24px 0 0;
  }

  /* THE PORTRAIT IS CAPPED, and the cap is mirrored in `portraitSizes`
     (src/layout.ts) so the width the CSS draws and the width the browser
     fetches cannot drift.

     Below the mode switch it is 200 px and NOT the full content width. A face
     at 100vw is the entire first screen on a phone, it would take the LCP
     element off the work and onto the author, and it would push the first Plate
     a screen and a half down. The cap is the whole reason this reads as a
     masthead rather than as a profile page. */
  /* <picture> is inline by default, which puts a descender's worth of gap under
     it — the same rule Plate.astro and the Project gallery each carry, and the
     same `:global()` reach the gallery uses, because the element comes from a
     component rather than from this template. */
  .masthead-aside :global(picture) {
    display: block;
  }

  .masthead-aside :global(img) {
    width: 200px;
    aspect-ratio: 1;
    object-fit: cover;
  }

  /* IT TAKES THE WHOLE COLUMN ONLY ON A GENUINELY LARGE WINDOW, and the second
     condition is the point. The mode switch is a SHAPE, so a 844x390 landscape
     phone gets the desktop grid — a fixed 320 px portrait beside a text column
     that has shrunk to about 430 px. Seen at that size: the face is the largest
     thing on screen and the Masthead stops being mostly words.

     `min-width: 1200px` is tokens.css's existing boundary for exactly this, "how
     much air a genuinely large window gets once it is already in the wide mode".
     Reused rather than a new number, so there is still one of them. Below it the
     portrait stays at its stacked size and the column simply has air in it. */
  @media (min-aspect-ratio: 1 / 1) and (min-width: 1200px) {
    .masthead-aside :global(img) {
      width: 100%;
    }
  }

  /* `inline-block` so the border is the width of the word rather than the width
     of the column. */
  .about {
    display: inline-block;
    margin-top: 20px;
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
  }

  /* The only --t-h1 on the site. Tracking comes from base.css at -0.02em; this
     rule used to restate it as -0.022em, a difference of two thousandths of an
     em that no one could see and that made the site's largest heading the one
     place the shared value did not apply. */
  h1 {
    font-size: var(--t-h1);
    line-height: 0.96;
  }

  /* THE ROLE IS A LABEL, and it now says so. It was Montserrat at its own size,
     which made it a fourth heading size on a page that already had two — and the
     argument for it ("a title, not reading, in the same voice as the name") is
     equally an argument for the mono datum voice, which is where the Social Card
     has always set this exact string.

     So the eyebrow and the role now bracket the name in the same style: what the
     page is above it, who the site is below it, and one very large name between.
     Everything else here is furniture in the same 11-12px mono, which is the
     whole point of a datum. */
  .role {
    margin: 24px 0 0;
  }

  /* An <ol> because the Plates are ordered and `order` is the curation. The
     list markers go; the semantics stay. */
  .plates {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* `isolation: isolate` confines the z-index below to this Plate. Without it
     the overlay's `z-index: 1` competes in the root stacking context, because
     `position: relative` with `z-index: auto` does not open one. Plates do not
     overlap today so nothing would look wrong, which is exactly why it is worth
     one declaration now rather than a puzzle later. */
  .plate {
    position: relative;
    isolation: isolate;
    display: grid;
    gap: 20px;
    margin-bottom: var(--rhythm);
  }

  .plate:last-child {
    margin-bottom: 0;
  }

  /* DOM order is metadata then image, which is also the reading order a screen
     reader gets: the Project's name before its picture. On desktop the two are
     placed into an explicit grid rather than reordered with `order`, so the
     visual arrangement is a placement instead of a contradiction of the DOM. */
  @media (min-aspect-ratio: 1 / 1) {
    .plate {
      grid-template-columns: minmax(0, 1fr) var(--plate-meta);
      gap: var(--plate-gap);
      align-items: start;
    }

    .plate-media {
      grid-column: 1;
      grid-row: 1;
    }

    .plate-meta {
      grid-column: 2;
      grid-row: 1;
    }
  }

  .ordinal {
    margin: 0;
  }

  /* THE PLATE INDEX MARK, in ink. It was signal red, and the change is a
     direction call rather than a compliance one: the site is greyscale
     everywhere the images are not, so that the eye goes to the work instead of
     to the furniture around it. A red tick above every heading is the most
     chromatic thing on a page full of renders, and it was competing.

     WHAT THIS LEAVES BEHIND: --signal is now used by exactly one selector on
     the whole site, the :focus-visible outline in base.css. That is the state
     docs/design-direction.md now records. The token stays and its 3:1 floor in
     scripts/check-css.mjs stays with it — a focus ring is the one affordance
     that has to be unmistakable, and it is only ever on screen for a visitor
     who is navigating by keyboard.

     A background, never a colour, and that part is unchanged: --signal fails
     4.5:1 as text and check-css.mjs refuses it in a `color:` declaration by
     name. Nothing about going to ink relaxes that. */
  .ordinal::before {
    content: '';
    display: block;
    width: 26px;
    height: 2px;
    margin-bottom: 12px;
    background: var(--ink);
  }

  .title {
    margin: 14px 0 0;
    font-size: var(--t-h3);
    line-height: 1.1;
  }

  /* One link per Plate, and it covers the whole row. The <a> is on the title so
     its accessible name is the Project's name; the pseudo-element extends the
     hit area over the image without adding a second link to the same URL for a
     screen reader to read out twice.

     `z-index: 1` IS LOAD-BEARING AND THE BUG IT FIXES IS SILENT. Without it the
     overlay covered the image and the image still took the click, so the single
     largest, most obviously clickable thing on the page did nothing. Confirmed
     with elementsFromPoint over the image centre, which returned
     [IMG, A, PICTURE, .plate-media, .plate] — the overlay present, and under.

     The cause is grid painting order, not a mistake in the geometry. Grid items
     paint as atomic units in document order (CSS Grid §6), and `.plate-media`
     follows `.plate-meta` in the DOM — the order the screen-reader argument
     above chose deliberately. So the later item painted over the earlier item's
     positioned descendant. Do not "fix" this by reordering the DOM; that trades
     a silent mouse bug for a reading-order one.

     NO HOVER STATE, here or anywhere else on the site. `text-decoration: none`
     and base.css's `color: inherit` are the whole of it, and the row does not
     respond to a pointer at all. That is the current state rather than an
     oversight — see docs/motion.md. */
  .title a {
    text-decoration: none;
  }

  .title a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  /* No font-size and no line-height. This is body prose and it is now set like
     body prose — the 15px it used to carry was the site's only second serif
     size, and it existed so that a summary would fit the metadata column, which
     is a layout problem being solved in the type scale. The column is 320px and
     these run two to four lines at 17px, which it has room for. */
  .summary {
    margin: 14px 0 0;
    color: var(--muted);
  }

  .spec {
    margin: 18px 0 0;
  }

  .year {
    margin: 6px 0 0;
  }
</style>
