---
import Base from '../layouts/Base.astro';
import { EMAIL, LINKEDIN } from '../site';

/* sameAs is legal here because the footer renders the link — the governing rule
   in docs/content-architecture.md is that if no page renders a field, the field
   does not exist. `address` still fails that test and stays out until /about/
   lands. */
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Coulter Heiberger',
  jobTitle: 'Architectural Visualization Specialist',
  url: 'https://coulterheiberger.com',
  email: `mailto:${EMAIL}`,
  sameAs: [LINKEDIN],
};
---

<Base
  title="Coulter Heiberger — Architectural Visualization"
  description="Architectural visualization by Coulter Heiberger. Portfolio in progress."
  structuredData={person}
>
  <main>
    <span class="t-label eyebrow">Portfolio in progress</span>
    <h1>Coulter Heiberger</h1>
    <p class="t-display role">Architectural Visualization</p>
  </main>
</Base>

<style>
  /* TWO of the three type roles, not three. A handful of lines do not need
     three families: this page is Montserrat (name, role) and JetBrains Mono
     (the eyebrow, and the footer below it). The serif is not absent from the
     site — /404 still sets prose in it — it is absent from a page that has no
     prose to read, which is the only job the direction kept it for.

     This is a page-level choice, not a change to docs/design-direction.md. The
     hard cap of three roles is a ceiling, not a quota. */
  main {
    max-width: 1600px;
    margin-inline: auto;
    padding: var(--rhythm) var(--gutter);
  }

  .eyebrow {
    display: block;
    margin-bottom: 20px;
  }

  h1 {
    font-size: clamp(2.4rem, 7.4vw, 5.25rem);
    line-height: 0.96;
    letter-spacing: -0.022em;
  }

  /* Montserrat, not the serif. "Architectural Visualization" is a title, not
     reading — it belongs to the same voice as the name directly above it.
     Tracking comes from .t-display and matches the h1 at -0.02em. */
  .role {
    margin: 24px 0 0;
    font-size: clamp(1.125rem, 1.9vw, 1.375rem);
    line-height: 1.5;
  }

  /* The email address used to be a fourth line here. Issue #34 moved it into
     src/components/Footer.astro, where it is on every page instead of one, and
     it is NOT duplicated back — the address appears once per page. The notes
     that used to live here about the lowercase mono cut moved with it. */
</style>
