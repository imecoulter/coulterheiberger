---
import Base from '../layouts/Base.astro';

const email = 'ime@coulterheiberger.com';

// `worksFor` and `affiliation` are NEVER added here. They are the obvious next
// schema.org enrichment and they are wrong: this site describes an independent
// practice, and an organization edge would assert something it does not claim.
// See ADR-0004.
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Coulter Heiberger',
  jobTitle: 'Technical Artist',
  url: 'https://coulterheiberger.com',
  email: `mailto:${email}`,
};
---

<Base
  title="Coulter Heiberger — Technical Artist"
  description="Real-time systems for spatial environments: terrain, architecture, simulation, and interactive experiences. Portfolio in progress."
  structuredData={person}
>
  <main>
    <span class="t-label eyebrow">Portfolio in progress</span>
    <h1>Coulter Heiberger</h1>
    <p class="t-display role">Technical Artist</p>
    <p class="t-label email"><a href={`mailto:${email}`}>{email}</a></p>
  </main>
</Base>

<style>
  /* TWO of the three type roles, not three. Four lines do not need three
     families: this page is Montserrat (name, role) and JetBrains Mono (the two
     utility lines), at three sizes. The serif is not absent from the site —
     /404 still sets prose in it — it is absent from a page that has no prose to
     read, which is the only job the direction kept it for.

     This is a page-level choice, not a change to docs/design-direction.md. The
     hard cap of three roles is a ceiling, not a quota. */
  main {
    max-width: 1600px;
    margin-inline: auto;
    padding: var(--rhythm) var(--gutter);
  }

  .eyebrow {
    display: block;
    margin-bottom: 20px;
  }

  h1 {
    font-size: clamp(2.4rem, 7.4vw, 5.25rem);
    line-height: 0.96;
    letter-spacing: -0.022em;
  }

  /* Montserrat, not the serif. "Technical Artist" is a title, not reading —
     it belongs to the same voice as the name directly above it.
     Tracking comes from .t-display and matches the h1 at -0.02em. */
  .role {
    margin: 24px 0 0;
    font-size: clamp(1.125rem, 1.9vw, 1.375rem);
    line-height: 1.5;
  }

  /* The same mono role as the eyebrow, at the same size — deliberately. This
     was .t-spec, which is 0.6875rem against the eyebrow's 0.75rem: a 1px
     difference, too small to read as hierarchy and big enough to read as a
     mistake. .t-spec is for specification lines (`Cycles · 3200 px · 41 min`);
     an email address is a label.

     Uppercase and label tracking are switched off: an address is data you read
     and type, not a phrase set in caps, and IME@COULTERHEIBERGER.COM was the
     most actionable line on the page and the hardest to read. The href was
     always lowercase, so nothing about the link changes.

     THIS LINE DEPENDS ON THE FONT CUT. MONO_SPEC was uppercase-only, and
     `text-transform: none` against that subset does not lowercase the line, it
     shatters it — `@` and `.` from JetBrains Mono, every letter from Consolas.
     U+0061-007A was added to the cut for exactly this line (+1,208 B, taking
     the stack to 14,884 B against a 500 KB ceiling). If the
     mono subset is ever narrowed again, this rule breaks silently and visibly. */
  .email {
    margin: calc(var(--rhythm) * 0.5) 0 0;
    text-transform: none;
    letter-spacing: normal;

    & a {
      text-decoration: none;
      border-bottom: 1px solid var(--rule);
    }
  }
</style>
