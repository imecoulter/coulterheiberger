---
import Base from '../layouts/Base.astro';
---

<Base
  title="Not found — Coulter Heiberger"
  description="That page doesn't exist."
  noindex
>
  <main>
    <h1>404</h1>
    <p>That page doesn't exist.</p>
    <p><a href="/">Back to the start</a></p>
  </main>
</Base>

<style>
  /* Ground, ink, families and muted all come from tokens.css. This page used to
     declare its own — a pre-Datum :root block with hex literals for --bg/--fg/
     --muted plus font-family: ui-sans-serif — which issue #21 caught rendering a
     FOURTH family on a live page.

     Astro does not scope `:root`, so that block was emitted unscoped and
     overrode the derived --muted site-wide on this document, replacing a
     color-mix() with a hard-coded hex. That is the one thing docs/styling.md
     forbids outright: a component never hard-codes a value a token names, and
     never redefines a derived token. Nothing here paints a colour now. */

  /* No min-height here. `body` is a flex column and `main` takes `flex: 1`
     from base.css, so this fills everything the footer does not — a 100dvh
     main plus a footer is one screen and a bit, which is a 404 you scroll. */
  main {
    display: grid;
    place-items: center;
    padding: var(--gutter);
    text-align: center;
  }

  h1 {
    font-size: clamp(2rem, 8vw, 3.25rem);
    letter-spacing: -0.03em;
  }

  p {
    color: var(--muted);
  }

  a {
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
  }
</style>
