---
/* The Plate's image, and the one place the two art-directed crops are produced.

   docs/design-direction.md requires every Plate to carry two crops — 21:9 wide,
   4:5 at 390 px — because the prototype's one un-art-directed plate collapsed to
   an illegible 140 px band. `<Picture>` cannot express that: it switches FORMAT
   across <source>, not COMPOSITION across a breakpoint. So the <picture> is
   assembled here from getImage() calls, and this component exists so that it is
   assembled exactly once.

   THE WIDE CROP IS CUT AT 16:9 AND SHOWN AT 21:9, AND THE EXCESS CURRENTLY HAS
   NO CONSUMER. That slack is the Overscan (CONTEXT.md), and it existed for the
   Traverse — the pointer-driven travel that used to move the band through it.
   The Traverse is gone and the pair is kept anyway, deliberately: re-cutting the
   wide tier at 21:9 would reclaim ~31% of its pixels but makes rebuilding the
   move an edit to src/layout.ts plus a re-encode of every wide variant, which
   also invalidates CI's processed-image cache. Kept, the move is CSS only.

   So the band a visitor sees is produced by `object-fit: cover` in the style
   block below rather than by sharp, and it rests at the author's `framing`
   keyword. src/layout.ts holds the pair and the reasoning.

   That is not the only reason it is a component rather than markup on two pages.
   `/` and `/projects/<slug>/` emit the IDENTICAL crop, and two copies of this
   markup would agree on the day they were written and diverge on the day one
   route's ratio was tuned.

   VERIFIED BY BUILDING, not read (this repo's ethic, and the trap is silent):
   passing `aspectRatio` alongside a `widths` ladder does NOT crop — Astro emits
   the SOURCE ratio at every width and reports the requested aspectRatio in the
   attributes while doing it. Only explicit `width` + `height` reaches sharp's
   `fit: 'cover'`. Measured on cecret's hero: explicit gave 2.333 at all four
   widths, `aspectRatio` gave 1.778 at all four. */
import { getImage } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import {
  WIDE,
  WIDE_SOURCE,
  TALL,
  WIDE_WIDTHS,
  TALL_WIDTHS,
  WIDE_FALLBACK,
  TALL_FALLBACK,
  WIDE_MODE,
  cssRatio,
  heightFor,
  restY,
  indexWideSizes,
  indexTallSizes,
  detailWideSizes,
  detailTallSizes,
} from '../layout';

type Frame = CollectionEntry<'projects'>['data']['images'][number];

interface Props {
  frame: Frame;
  /** Which presentation. The crops are identical either way; only the width the
      image is laid out at, and therefore `sizes`, differs. */
  context: 'index' | 'detail';
  /** The LCP element. At most one per page. */
  priority?: boolean;
}

/* TWO PROPS FEWER THAN THIS ONCE TOOK, AND BOTH WERE MOTION.

   `anim` carried Registration's `wipe`; owner review removed the Plates'
   entrance and left it with nothing to pass. `slug` became the Carry's
   <custom-ident> (`plate-<slug>`) and had exactly that one consumer, so it went
   with the Carry. Neither is a prop to reinstate casually — docs/motion.md holds
   what each was for, including why the ident had to start with a letter. */
const { frame, context, priority = false } = Astro.props;

const wideSizes = context === 'index' ? indexWideSizes : detailWideSizes;
const tallSizes = context === 'index' ? indexTallSizes : detailTallSizes;

/** One tier: a format at one crop, across a width ladder. The `src` is the
    ladder's top entry and `srcSet` carries the rest; `position` is the Plate's
    own `framing`, passed to sharp unchanged (issue #30). */
const tier = (
  crop: { readonly w: number; readonly h: number },
  widths: number[],
  format: 'avif' | 'webp' | 'jpeg',
) => {
  const width = widths[widths.length - 1];
  return getImage({
    src: frame.src,
    width,
    height: heightFor(width, crop),
    widths,
    format,
    position: frame.framing,
  });
};

/* WIDE_SOURCE, not WIDE. The wide file is cut looser than the band it is shown
   in; the difference is the Overscan, which is unused today and kept for the
   reason at the top of this file. The TALL tiers are cut at exactly what they
   are shown at. See src/layout.ts for the pair and what it costs. */
const wideAvif = await tier(WIDE_SOURCE, WIDE_WIDTHS, 'avif');
const wideWebp = await tier(WIDE_SOURCE, WIDE_WIDTHS, 'webp');
const wideJpeg = await tier(WIDE_SOURCE, WIDE_FALLBACK, 'jpeg');
const tallAvif = await tier(TALL, TALL_WIDTHS, 'avif');
const tallWebp = await tier(TALL, TALL_WIDTHS, 'webp');
const tallJpeg = await tier(TALL, TALL_FALLBACK, 'jpeg');

/* Which crop a window gets is the same question as which way the page lays out,
   so it asks the same condition: wider than tall takes the band, taller than
   wide takes the 4:5. layout.ts exports it as WIDE_MODE and tokens.css turns
   --gutter and --rhythm over on it. Imported rather than restated so the crops
   and the gutters cannot disagree — a `media` attribute cannot read a custom
   property, but it can read a build-time constant. */
const WIDE_MEDIA = WIDE_MODE;

/* Set once on the <picture> and inherited by the <img>, rather than through
   `define:vars` — which stamps the same properties onto every element the
   component emits, six per Plate, on a document that is itself on the LCP Path.
   The point of routing these through layout.ts at all is that the ratio the box
   is drawn at comes from the same pair as the height sharp cut the file to.

   --rest-y is where the wide crop sits in its box, and it is the author's own
   `framing` keyword. It is not decoration: the wide file is larger than its box,
   so without this the browser would centre the Overscan and throw away the
   composition decision sharp had just honoured. */
const vars = [
  `--wide-ratio: ${cssRatio(WIDE)}`,
  `--tall-ratio: ${cssRatio(TALL)}`,
  `--rest-y: ${restY(frame.framing)}`,
].join('; ');
---

<picture style={vars}>
  <source media={WIDE_MEDIA} type="image/avif" srcset={wideAvif.srcSet.attribute} sizes={wideSizes} />
  <source media={WIDE_MEDIA} type="image/webp" srcset={wideWebp.srcSet.attribute} sizes={wideSizes} />
  {/* The wide JPEG is a single width, not a ladder — see WIDE_FALLBACK. */}
  <source media={WIDE_MEDIA} type="image/jpeg" srcset={wideJpeg.src} sizes={wideSizes} />
  <source type="image/avif" srcset={tallAvif.srcSet.attribute} sizes={tallSizes} />
  <source type="image/webp" srcset={tallWebp.srcSet.attribute} sizes={tallSizes} />
  {/* The <img> carries the TALL crop deliberately. It is reached only when no
      <source> above matched — i.e. no AVIF and no WebP — and if any device is
      still in that population it is far likelier to be an old phone than an old
      desktop. Serving it the 21:9 band would hand exactly that visitor the
      140 px collapse the two crops exist to prevent. */}
  <img
    src={tallJpeg.src}
    alt={frame.alt}
    width={TALL_FALLBACK[0]}
    height={heightFor(TALL_FALLBACK[0], TALL)}
    loading={priority ? 'eager' : 'lazy'}
    decoding={priority ? 'sync' : 'async'}
    fetchpriority={priority ? 'high' : undefined}
  />
</picture>

<style>
  /* `display: block` because <picture> is inline by default, which would put a
     descender's worth of gap under every Plate.

     `overflow: hidden` is INERT TODAY and kept on purpose. Nothing overflows
     this element now — `object-fit: cover` clips inside the <img>'s own box —
     but this is the clip box, and anything that lays the image out larger than
     its frame or clips it belongs here rather than on the <img>. docs/motion.md
     records what naming the wrong one of those two cost. */
  picture {
    display: block;
    overflow: hidden;
  }

  /* TALL: the box is drawn at the same ratio the file was cut to, so `cover` is
     doing nothing but absorbing rounding.

     WIDE: the box is 21:9 and the file is 16:9, so `cover` is doing real work —
     it is the crop that produces the band, and `object-position` chooses where
     in the file that band falls. That is the whole mechanism.

     --rest-y is the vertical half of the author's `framing` keyword, and with
     the Traverse gone it is the only thing positioning the band. It used to be
     the midpoint of a clamped range the pointer moved through; it is now simply
     where the band sits. The horizontal half is a flat 50% because the file and
     the box are the same width, so there is nothing sideways to choose. */
  img {
    width: 100%;
    height: auto;
    aspect-ratio: var(--tall-ratio);
    object-fit: cover;
    object-position: 50% var(--rest-y, 50%);
  }

  @media (min-aspect-ratio: 1 / 1) {
    img {
      aspect-ratio: var(--wide-ratio);
    }
  }
</style>
