---
/* The metadata contract. Every piece of work is this object; only `spec` differs. */
import MetaList from './MetaList.astro';

interface Props {
  index: string;
  what: string;
  spec: string;
  alt: string;
  wide: string;
  tall: string;
  width: number;
  height: number;
  priority?: boolean;
  rows: { term: string; value: string }[];
}

const { index, what, spec, alt, wide, tall, width, height, priority = false, rows } = Astro.props;
---

<div class="plate-block">
  <MetaList rows={rows} />

  <figure class="plate">
    <picture>
      <source media="(max-width: 719px)" srcset={tall} />
      <img
        src={wide}
        width={width}
        height={height}
        alt={alt}
        fetchpriority={priority ? 'high' : undefined}
        loading={priority ? 'eager' : 'lazy'}
      />
    </picture>
    <figcaption>
      <span class="idx">{index}</span>
      <span class="what">{what}</span>
      <span class="spec">{spec}</span>
    </figcaption>
  </figure>
</div>

<style>
  .plate-block {
    padding-block: calc(var(--rhythm) * 0.5);
    display: grid;
    gap: 32px;
  }

  @media (min-width: 900px) {
    .plate-block {
      grid-template-columns: minmax(180px, 1fr) minmax(0, 3.4fr);
      gap: 48px;
    }
  }

  .plate {
    margin: 0;

    & img {
      width: 100%;
    }
  }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    align-items: baseline;
    border-top: 1px solid var(--rule);
    margin-top: 12px;
    padding-top: 10px;
    font-family: var(--f-mono);
    font-size: var(--t-spec);
    letter-spacing: var(--track-spec);

    & .idx {
      color: var(--signal);
    }

    & .what {
      text-transform: uppercase;
    }

    & .spec {
      text-transform: uppercase;
      color: var(--muted);
      margin-left: auto;
    }
  }
</style>
