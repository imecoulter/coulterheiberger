---
/* THE night band — exactly one per page. `night` (global, in tokens.css)
   reassigns the semantic tokens; `band` just paints and spaces. Nothing
   inside it knows it is in a night band. */
---

<section class="night band">
  <slot />
</section>

<style>
  .band {
    background: var(--ground);
    color: var(--ink);
    padding-block: calc(var(--rhythm) * 0.7);
    margin-block: calc(var(--rhythm) * 0.5);
  }
</style>
