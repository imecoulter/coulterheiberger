---
import Wrap from './Wrap.astro';

const email = 'ime@coulterheiberger.com';
---

<Wrap>
  <footer>
    <div class="cols">
      <span>Coulter Heiberger — Architectural visualization</span>
      <span><a href={`mailto:${email}`}>{email}</a></span>
    </div>
  </footer>
</Wrap>

<style>
  footer {
    padding-block: 48px calc(var(--rhythm) * 0.4);
    border-top: 1px solid var(--rule);
    font-family: var(--f-mono);
    font-size: var(--t-spec);
    text-transform: uppercase;
    letter-spacing: var(--track-spec);
    color: var(--muted);

    & .cols {
      display: flex;
      flex-wrap: wrap;
      gap: 24px 48px;
      justify-content: space-between;
    }

    & a {
      text-decoration: none;
      border-bottom: 1px solid var(--rule);
    }
  }
</style>
