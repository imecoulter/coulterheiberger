# build output
dist/
# generated types
.astro/
# processed-image cache. Outside node_modules so it survives `npm ci` and CI can
# restore it with actions/cache — see astro.config.mjs and issue #3.
.astro-cache/
# wrangler local state
.wrangler/
# lighthouse ci run output — untracked but unignored until now (found by
# research on issue #5)
.lighthouseci/
# local TEMP for lighthouse: chrome-launcher's cleanup throws EPERM against the
# Windows user temp dir, which aborts `lhci collect` after "Generating results"
# and leaves .lighthouseci/ empty while the run still exits 0. Point TEMP/TMP
# here to get results out of it.
.tmp-lh/

# agent worktrees
.claude/worktrees/
# playwright-mcp scratch (screenshots, snapshots) from checking pages by eye
.playwright-mcp/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# Local font subsetting venv (scripts/dev/subset-fonts.mjs). Never committed;
# the woff2 subsets under src/fonts/ are the artifact CI consumes.
.venv-fonts/
