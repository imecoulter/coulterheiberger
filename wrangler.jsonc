{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "coulterheiberger-com",
  "account_id": "246c2210da4b82bbc1e633c858c63571",
  "compatibility_date": "2026-08-10",
  // Bare *.workers.dev route stays off — production is the custom domain only.
  // Preview URLs are a separate toggle and work independently of workers_dev;
  // proved via direct API against the account's coulterjheiberger.workers.dev
  // subdomain (issue #9). Every *.workers.dev response also gets an automatic
  // X-Robots-Tag: noindex from Cloudflare.
  "workers_dev": false,
  "preview_urls": true,
  // Static assets only — no Worker script. See docs/adr/0001-astro-static-on-cloudflare-workers.md
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Apex only. coulterjheiberger.com -> coulterheiberger.com is a 301 handled
  // by a dynamic redirect ruleset on that zone, not by this Worker.
  "routes": [
    {
      "pattern": "coulterheiberger.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
