{
  "extraKnownMarketplaces": {
    "imecoulter-skills": {
      "source": {
        "source": "github",
        "repo": "imecoulter/skills"
      }
    }
  },
  "enabledPlugins": {
    "imecoulter-skills@imecoulter-skills": true
  },
  "autoCompactWindow": 283000,
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(./dist/**)",
      "Read(./build/**)",
      "Read(./node_modules/**)"
    ]
  }
}
